{
    "version": "8.10.0-SNAPSHOT",                        // Lens 插件版本，标识此可视化配置所对应的 Kibana/Lens 版本
    "type": "lens",                                      // 面板类型，此处为 Lens 可视化
    "gridData": {                                        // Dashboard 布局信息，定义面板在网格中的位置和大小
      "x": 0,                                            // 面板左上角在网格中的横向起始坐标（列索引，从 0 开始）
      "y": 55,                                           // 面板左上角在网格中的纵向起始坐标（行索引，从 0 开始）
      "w": 24,                                           // 面板占用的网格宽度（列数）
      "h": 15,                                           // 面板占用的网格高度（行数）
      "i": "75bf2224-805f-46a1-9ba6-9ceb1d59258d"        // 面板唯一 ID，与 panelIndex 保持一致，用于布局管理
    },
    "panelIndex": "75bf2224-805f-46a1-9ba6-9ceb1d59258d",// 面板在 Dashboard 中的唯一标识符（同 gridData.i）
    "embeddableConfig": {                                // 可嵌入配置，包含 Lens 可视化的所有属性
      "attributes": {
        "title": "",                                     // 面板标题（Dashboard 上展示），此处为空表示不单独显示标题
        "description": "",                               // 面板描述，通常用于 Tooltip，此处留空
        "visualizationType": "lnsXY",                    // Lens 可视化类型，此处选择 XY 系列（支持折线、柱状、堆叠等）
        "type": "lens",                                  // 指明这是一个 Lens 可视化
        "references": [                                  // 外部资源引用，通常为 index-pattern
          {
            "type": "index-pattern",                     // 引用类型，此处为 index-pattern
            "id": "APM_STATIC_DATA_VIEW_ID",             // 被引用的 Index Pattern ID
            "name": "indexpattern-datasource-layer-0a3b7d42-6be0-4d63-89b4-1ff4f845bb2b"  
                                                         // 在 state 中引用该 index-pattern 的名称，用于数据源关联
          }
        ],
        "state": {                                       // Lens 可视化的状态，包含可视化和数据源配置
          "visualization": {                             // 可视化外观设置
            "legend": {
              "isVisible": true,                         // 是否展示图例
              "position": "bottom"                       // 图例位置，此处放置在底部
            },
            "valueLabels": "hide",                       // 是否在柱子/折线数据点上显示数值标签，此处隐藏
            "fittingFunction": "None",                   // 拟合函数，针对时间序列是否插值，此处不做插值
            "axisTitlesVisibilitySettings": {
              "x": true,                                 // 是否显示 X 轴标题
              "yLeft": true,                             // 是否显示左侧 Y 轴标题
              "yRight": true                             // 是否显示右侧 Y 轴标题（本例主要用左侧）
            },
            "tickLabelsVisibilitySettings": {
              "x": true,                                 // 是否显示 X 轴刻度标签
              "yLeft": true,                             // 是否显示左侧 Y 轴刻度标签
              "yRight": true                             // 是否显示右侧 Y 轴刻度标签
            },
            "labelsOrientation": {
              "x": 0,                                    // X 轴刻度标签旋转角度（0 表示不旋转）
              "yLeft": 0,                                // 左侧 Y 轴刻度标签旋转角度
              "yRight": 0                                // 右侧 Y 轴刻度标签旋转角度
            },
            "gridlinesVisibilitySettings": {
              "x": true,                                 // 是否显示横向网格线
              "yLeft": true,                             // 是否显示纵向网格线（左轴方向）
              "yRight": true                             // 是否显示纵向网格线（右轴方向）
            },
            "preferredSeriesType": "bar_stacked",        // 首选系列类型，此处为堆叠柱状图
            "layers": [                                  // 可视化图层配置数组，此例只有一个图层
              {
                "layerId": "0a3b7d42-6be0-4d63-89b4-1ff4f845bb2b", // 图层 ID，对应 datasourceStates 中的图层
                "accessors": [                                   // 本图层的度量列列表
                  "7bf46237-c31f-4b20-9f35-404b6b580f34"         // “每分钟 GC 次数增量”列 ID
                ],
                "position": "top",                              // 堆叠时此图层位于顶部（仅影响多层堆叠顺序）
                "seriesType": "bar_stacked",                     // 本图层使用堆叠柱状图渲染
                "showGridlines": false,                          // 是否单独为本图层显示网格线，此处不显示
                "layerType": "data",                             // 图层类型，此处从数据源获取数据
                "xAccessor": "60035d22-9253-4968-907b-9aa3a92d989a",  
                                                                    // X 轴使用的列 ID，对应 date_histogram（时间分桶）
                "splitAccessor": "1e4f1019-33a4-4333-b1ef-163695a70cf3"  
                                                                    // 拆分列 ID，用于按 GC 类型（labels.name）堆叠
              }
            ],
            "yLeftExtent": {
              "mode": "full"                                     // Y 轴范围模式，“full”表示不裁剪最大值，自适应
            },
            "yTitle": "GC rate [count per minute]"              // 左侧 Y 轴标题文字，表示“每分钟 GC 次数增量”
          },
          "query": {                                            // KQL 查询配置，用于初步筛选数据
            "query": "jvm.gc.count : *",                        // 只包含 jvm.gc.count 字段有值的文档
            "language": "kuery"                                  // 查询语言，使用 Kibana Query Language
          },
          "filters": [],                                         // 额外的过滤器数组，此处为空
          "datasourceStates": {
            "formBased": {                                       // Form-based 数据源配置
              "layers": {
                "0a3b7d42-6be0-4d63-89b4-1ff4f845bb2b": {         // 对应上文 visualization.layers.layerId
                  "columns": {                                   // 列配置对象，键为 columnId
                    "60035d22-9253-4968-907b-9aa3a92d989a": {     // 列 ID，对应 @timestamp 分桶
                      "label": "@timestamp",                     // 列显示名称
                      "dataType": "date",                        // 数据类型为日期
                      "operationType": "date_histogram",         // 操作类型为时间分桶
                      "sourceField": "@timestamp",                // 原始字段名
                      "isBucketed": true,                        // 表示这是一个分桶列
                      "scale": "interval",                       // 度量尺度，时间间隔
                      "params": {
                        "interval": "auto",                     // 自动选择合适的时间间隔
                        "includeEmptyRows": true,               // 即使没有数据也保留空桶
                        "dropPartials": false                   // 不丢弃不完整的桶
                      }
                    },
                    "7bf46237-c31f-4b20-9f35-404b6b580f34": {       // 列 ID，对应 Counter rate 计算
                      "label": "Counter rate of jvm.gc.count per minute",  
                                                                    // 列显示名称，表示“每分钟 GC 次数增量”
                      "dataType": "number",                       // 数据类型为数值
                      "operationType": "counter_rate",            // 操作类型为计数速率（增量）
                      "isBucketed": false,                        // 不是分桶列，而是度量列
                      "scale": "ratio",                            // 度量尺度为比例
                      "references": [                             // 引用其他列的 ID，用于计算
                        "2cccccbc-e467-4be8-bbd4-0563bd1dd785"
                      ],
                      "timeScale": "m"                            // 时间单位“分钟”，按分钟计算增量
                    },
                    "2cccccbc-e467-4be8-bbd4-0563bd1dd785": {       // 引用列 ID，对应 max(jvm.gc.count)
                      "label": "Maximum of jvm.gc.count",         // 列显示名称，表示“jvm.gc.count 最大值”
                      "dataType": "number",                       // 数据类型为数值
                      "operationType": "max",                     // 操作类型为取最大值
                      "sourceField": "jvm.gc.count",              // 原始字段名
                      "isBucketed": false,                        // 不是分桶列
                      "scale": "ratio",                            // 度量尺度为比例
                      "params": {
                        "emptyAsNull": true                       // 如果字段缺失则视为 null
                      }
                    },
                    "1e4f1019-33a4-4333-b1ef-163695a70cf3": {       // 列 ID，对应 labels.name 分桶
                      "label": "Top 3 values of labels.name",      // 列显示名称，表示“labels.name 的 Top3”
                      "dataType": "string",                        // 数据类型为字符串
                      "operationType": "terms",                    // 操作类型为分桶（terms 聚合）
                      "scale": "ordinal",                          // 度量尺度为.ordinal（离散枚举）
                      "sourceField": "labels.name",                 // 原始字段名
                      "isBucketed": true,                          // 表示这是一个分桶列
                      "params": {
                        "size": 3,                                 // 只取出现频率最高的 3 个值
                        "orderBy": {
                          "type": "alphabetical",                 // 按字母顺序排序
                          "fallback": true                        // 如果无法按频率排序，使用字母顺序
                        },
                        "orderDirection": "asc",                   // 排序方向“升序”
                        "otherBucket": true,                       // 将 Top3 之外的值归为“Other”分桶
                        "missingBucket": false,                    // 不单独显示缺失值分桶
                        "parentFormat": {
                          "id": "terms"                           // 上层格式标识
                        },
                        "include": [],                             // 可通过此数组显式包含某些值，留空
                        "exclude": [],                             // 可通过此数组显式排除某些值，留空
                        "includeIsRegex": false,                   // include 数组中值不使用正则
                        "excludeIsRegex": false                    // exclude 数组中值不使用正则
                      }
                    }
                  },
                  "columnOrder": [                               // 列在表格/查询中的顺序
                    "1e4f1019-33a4-4333-b1ef-163695a70cf3",      // 首先显示 labels.name 分桶
                    "60035d22-9253-4968-907b-9aa3a92d989a",      // 然后显示 @timestamp（时间分桶）
                    "7bf46237-c31f-4b20-9f35-404b6b580f34",      // 然后显示 counter_rate 结果
                    "2cccccbc-e467-4be8-bbd4-0563bd1dd785"       // 最后显示 max(jvm.gc.count) 列（仅用于计算）
                  ],
                  "incompleteColumns": {},                       // 用于指示是否存在未完全配置的列，此处无
                  "sampling": 1                                  // 采样率，1 表示不做抽样，读取全部数据
                }
              }
            },
            "indexpattern": {
              "layers": {}                                      // 备用结构，Form-based Lens 通常不使用
            },
            "textBased": {
              "layers": {}                                      // 备用结构，文本编辑模式下使用，Form-based 不使用
            }
          },
          "internalReferences": [],                              // Lens 内部引用，通常为空
          "adHocDataViews": {}                                   // 临时数据视图配置，通常为空
        },
        "hidePanelTitles": false,                                // 是否隐藏面板标题栏，false 表示不隐藏
        "enhancements": {}                                       // 扩展功能配置，目前为空
      },
      "title": "Garbage collection count per minute"             // Dashboard 上显示的面板标题
    }
  }
  